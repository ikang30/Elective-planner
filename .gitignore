# ── macOS ──────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Editor / IDE ────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Secrets / env files ─────────────────────────────────
# Never commit real secrets — Supabase credentials are
# already baked into index.html (anon key is safe to expose),
# but if you ever move them to an env file, ignore it here.
.env
.env.local
.env.*.local

# ── Logs ────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Node (for if/when you add a build step) ─────────────
node_modules/
dist/
build/
.cache/
.parcel-cache/

# ── Temporary files ─────────────────────────────────────
*.tmp
*.bak
*.orig
